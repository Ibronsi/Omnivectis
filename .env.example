# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL (Option 1 - Vercel / Supabase / Neon / Railway / Render)
DATABASE_URL=""
DB_SSL="true"

# PostgreSQL (Option 2 - Google Cloud SQL)
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""

# Firebase Project ID (optionnel si firebase-applet-config.json est présent)
FIREBASE_PROJECT_ID=""

# Secret optionnel pour sécuriser l'endpoint Cron (/api/cron/harvest) sur Vercel
CRON_SECRET=""

# APP_PASSWORD: Mot de passe d'accès optionnel supplémentaire protégeant les routes /api.
APP_PASSWORD=""

# Envoi réel d'e-mails après validation (Resend ou SMTP)
RESEND_API_KEY=""
RESEND_FROM=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Envoi réel de messages WhatsApp / Webhook après validation
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
OUTBOUND_WEBHOOK_URL=""
OUTBOUND_WEBHOOK_SECRET=""
